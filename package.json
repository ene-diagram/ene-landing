{
  "name": "ene-landing",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sync:tokens": "node scripts/sync-tokens.ts",
    "sync:player": "node scripts/sync-player.ts",
    "dev": "vite dev",
    "build": "node scripts/sync-tokens.ts && vite build",
    "preview": "vite preview",
    "i18n": "paraglide-js compile --project ./project.inlang",
    "check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "imports": {
    "#lib/components/*": "./src/lib/components/*",
    "#lib/styles/*": "./src/lib/styles/*",
    "#lib/paraglide/*": "./src/lib/paraglide/*.js",
    "#lib/*": "./src/lib/*.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
